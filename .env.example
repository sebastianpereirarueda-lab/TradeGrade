# Optional: enables sign-in and cloud sync. Without these the app is local-only.
# From your Supabase project: Settings -> API. The anon key is safe to publish;
# access is enforced by the row-level security policies in supabase/schema.sql.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
